  logo: static/assets/img/lands/desert_logo.png
  additional_slot_base_cost_diams: 10
  additional_slot_cost_multiplier: 1.5
  tools: {}
farm:
  key: land_farm
  label_fr: Ferme
  label_en: Farm
  starting_land: false
  slots: 10
  slot_icon: static/assets/img/lands/farm_slot.png
  logo: static/assets/img/lands/farm_logo.png
  additional_slot_base_cost_diams: 10
  additional_slot_cost_multiplier: 1.5
  tools: {}
forest:
  card_key: land_forest
  label: "Forest"
  short_description: "A simple forest"
  full_description: land_forest_description

  starting_land: true
  slots: 8
  slot_icon: static/assets/img/lands/forest_slot.png
  logo: static/assets/img/lands/forest_logo.png

  additional_slot_base_cost_diams: 10
  additional_slot_cost_multiplier: 1.5

  xp_per_collect: 1   # base XP pour ce land

  tools:
    hands:
      label: "Mains nues"
      emoji: "🤲"
      cooldown_seconds: 10
      xp_multiplier: 1.0
      base_loot:
        - resource: branch
          chance: 1.0
          min: 1
          max: 2
      extra_loot:
        - resource: palm_leaf
          chance: 0.10
          min: 1
          max: 1
        - resource: vine
          chance: 0.10
          min: 1
          max: 1
        - resource: small_stone
          chance: 0.05
          min: 1
          max: 1

    tool_wooden_axe:
      label: "Hache en bois"
      emoji: "🪓"
      cooldown_seconds: 20
      xp_multiplier: 1.2
      base_loot:
        - resource: palm_wood
          chance: 1.0
          min: 1
          max: 3
      extra_loot:
        - resource: apple
          chance: 0.10
          min: 1
          max: 1

    tool_wooden_shovel:
      label: "Pelle en bois"
      emoji: "🪣"
      cooldown_seconds: 15
      xp_multiplier: 1.1
      base_loot:
        - resource: dirt
          chance: 1.0
          min: 1
          max: 2
      extra_loot:
        - resource: worm
          chance: 0.10
          min: 1
          max: 1


lake:
  key: land_lake
  label_fr: Lac
  label_en: Lake
  starting_land: false
  slots: 5
  slot_icon: static/assets/img/lands/lake_slot.png
  logo: static/assets/img/lands/lake_logo.png
  additional_slot_base_cost_diams: 15
  additional_slot_cost_multiplier: 1.6
  tools:
    hands:
      base_loot:
      - resource: water_lily
        min: 1
        max: 1
        chance: 1.0
      - resource: anchovy
        min: 1
        max: 1
        chance: 0.5
      extra_loot: []
    rod:
      base_loot:
      - resource: sand
        min: 1
        max: 2
        chance: 1.0
      extra_loot:
      - resource: seashell
        min: 1
        max: 1
        chance: 0.001
